# Copiar a .env. No versionar valores privados.
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Crear esta base y un usuario dedicado. Sustituir la contraseña de ejemplo.
DATABASE_URL=postgresql+psycopg://cognova:CHANGE_ME@localhost:5432/cognova
# Generar un secreto aleatorio de al menos 32 bytes; nunca compartirlo.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# false solo en desarrollo HTTP local. En producción es obligatorio true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

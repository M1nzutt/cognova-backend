# Local Compose inputs. These example passwords are public placeholders and must
# be replaced in the private .env file before sharing or using a non-disposable host.
FRONTEND_PORT=8080
POSTGRES_PORT=55432

POSTGRES_ADMIN_PASSWORD=local-admin-change-this
COGNOVA_RUNTIME_PASSWORD=local-runtime-change-this
COGNOVA_MIGRATOR_PASSWORD=local-migrator-change-this

# Compose constructs Backend DATABASE_URL with cognova_runtime and hostname
# postgres:5432, using COGNOVA_RUNTIME_PASSWORD. The CORS origin is derived from
# FRONTEND_PORT and remains http://localhost in this local-only profile.
# At least 32 bytes. Generate a private value for your local .env.
JWT_SECRET=local-only-change-this-value-to-a-random-secret-of-at-least-32-bytes

# Optional. Leave empty to run without Gemini; Gemini endpoints return their
# documented safe unavailable response. This value is sent only to Backend.
GEMINI_API_KEY=

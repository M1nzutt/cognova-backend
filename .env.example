# Copiar a .env. No versionar valores privados.
CORS_ORIGINS=["http://localhost:5173"]
# Crear esta base y un usuario dedicado. Sustituir la contraseña de ejemplo.
DATABASE_URL=postgresql+psycopg://cognova:CHANGE_ME@localhost:5432/cognova
# Generar un secreto aleatorio de al menos 32 bytes; nunca compartirlo.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
